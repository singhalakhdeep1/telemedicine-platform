# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/telemedicine?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-token-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# Frontend
FRONTEND_URL="http://localhost:3000"

# Server
PORT=3001
NODE_ENV="development"

# Stripe
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
STRIPE_API_VERSION="2023-10-16"

# AWS S3
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="telemedicine-documents"

# Email (SendGrid)
SENDGRID_API_KEY="your_sendgrid_api_key"
SENDGRID_FROM_EMAIL="noreply@telemedicine.com"
SENDGRID_FROM_NAME="Telemedicine Platform"

# WebRTC (TURN/STUN servers)
TURN_SERVER_URL="turn:your-turn-server.com:3478"
TURN_USERNAME="turnuser"
TURN_CREDENTIAL="turnpassword"
STUN_SERVER_URL="stun:stun.l.google.com:19302"

# FHIR Server
FHIR_SERVER_URL="https://hapi.fhir.org/baseR4"
FHIR_API_KEY="your_fhir_api_key_optional"

# Encryption (AES-256-GCM)
ENCRYPTION_KEY="your-32-character-encryption-key-here"

# Redis (for caching/sessions)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Logging
LOG_LEVEL="info"
LOG_FILE_PATH="./logs"

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# CORS
CORS_ORIGIN="http://localhost:3000"

# Redis Cluster (optional — leave empty to use single-node Redis above)
REDIS_CLUSTER_NODE_1_HOST=""
REDIS_CLUSTER_NODE_1_PORT=""
REDIS_CLUSTER_NODE_2_HOST=""
REDIS_CLUSTER_NODE_2_PORT=""
REDIS_CLUSTER_NODE_3_HOST=""
REDIS_CLUSTER_NODE_3_PORT=""
REDIS_TLS="false"

# Read replicas (optional — leave empty to use primary DATABASE_URL)
READ_REPLICA_COUNT=0
DATABASE_READ_REPLICA_1_URL=""
DATABASE_READ_REPLICA_2_URL=""

# Database sharding (optional)
SHARD_COUNT=1
DATABASE_SHARD_0_URL=""

# WebRTC / recording (optional)
SFU_URL=""
TURN_BACKUP_URL=""
RECORDING_ENABLED="false"
RECORDING_AUTO_START="false"
RECORDING_FORMAT="mp4"
RECORDING_QUALITY="720p"
RECORDING_MAX_DURATION=3600
RECORDING_AUDIO_ONLY="false"
RECORDING_STORAGE_LOCATION="./recordings"
SCREEN_SHARING_ENABLED="true"
SCREEN_SHARE_AUDIO="false"
SCREEN_SHARE_WIDTH=1920
SCREEN_SHARE_HEIGHT=1080
SCREEN_SHARE_FRAME_RATE=15

# Log retention (optional)
LOG_AGGREGATION_ENABLED="false"
LOG_AGGREGATION_ENDPOINT=""
LOG_AGGREGATION_MAX_ENTRIES=10000
LOG_AGGREGATION_WINDOW=60
LOG_ARCHIVE_ENABLED="false"
LOG_ARCHIVE_LOCATION="./log-archive"
LOG_DEBUG_RETENTION_DAYS=7
LOG_INFO_RETENTION_DAYS=30
LOG_WARN_RETENTION_DAYS=90
LOG_ERROR_RETENTION_DAYS=365
LOG_SAMPLE_RATE=1.0
LOG_SAMPLING_ENABLED="false"
REPLICA_HEALTH_CHECK_INTERVAL=30000
